# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to true to run entirely on Supabase (no .NET backend needed)
VITE_SUPABASE_ONLY=true

# Only needed when VITE_SUPABASE_ONLY=false (microservices mode)
VITE_API_BASE_URL=http://localhost:5000
VITE_WSO2_ENABLED=false
