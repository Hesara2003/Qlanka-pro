        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_requests_received_total{job=~\"gateway|identity|service-center|queue\",code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_received_total{job=~\"gateway|identity|service-center|queue\"}[5m])), 1))",
          "legendFormat": "5xx",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API Error Rate (5xx)",
      "type": "gauge"
    },
