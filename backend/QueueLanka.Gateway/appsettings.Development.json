{
  "Wso2": {
    "Enabled": false,
    "Authority": "https://localhost:9443",
    "ValidIssuer": "https://localhost:9443/oauth2/token",
    "Audience": "REPLACE_WITH_WSO2_CLIENT_ID",
    "RequireHttpsMetadata": false,
    "AllowInvalidCertificate": true
  },
  "GatewayPolicies": {
    "Authentication": {
      "RequireAuthenticatedUserByDefault": true
    },
    "RateLimiting": {
      "Booking": {
        "Method": "POST",
        "Path": "/api/appointment/book",
        "PermitLimit": 5,
        "WindowMinutes": 1,
        "RejectionStatusCode": 429
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
