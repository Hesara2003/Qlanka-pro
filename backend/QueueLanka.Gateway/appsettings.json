{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "CHANGE_ME_USE_ENV_VAR_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "queuelanka-api",
    "Audience": "queuelanka-client"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        }
      },
      "admin-counters-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/admin/centers/{**catch-all}"
        }
      },
      "servicecenter-route": {
        "ClusterId": "servicecenter-cluster",
        "Match": {
          "Path": "/api/service-centers/{**catch-all}"
        }
      },
      "appointment-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/appointment/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        }
      },
      "api-reports-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "token-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/token/{**catch-all}"
        }
      },
      "counters-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/counters/{**catch-all}"
        }
      },
      "queue-hub-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-identity.internal.redrock-2a740b8b.centralindia.azurecontainerapps.io/"
          }
        }
      },
      "servicecenter-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-servicecenter.internal.redrock-2a740b8b.centralindia.azurecontainerapps.io/"
          }
        }
      },
      "queue-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-queue.internal.redrock-2a740b8b.centralindia.azurecontainerapps.io/"
          }
        }
      }
    }
  }
}