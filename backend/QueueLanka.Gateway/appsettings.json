{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "queuelanka-api",
    "Audience": "queuelanka-client"
  },
  "Wso2": {
    "Enabled": false,
    "Authority": "https://20.193.250.12:9443",
    "ValidIssuer": "https://20.193.250.12:9443/oauth2/token",
    "Audience": "REPLACE_WITH_WSO2_CLIENT_ID",
    "RequireHttpsMetadata": true,
    "AllowInvalidCertificate": false
  },
  "GatewayPolicies": {
    "Authentication": {
      "RequireAuthenticatedUserByDefault": true
    },
    "RateLimiting": {
      "Booking": {
        "Method": "POST",
        "Path": "/api/appointment/book",
        "PermitLimit": 5,
        "WindowMinutes": 1,
        "RejectionStatusCode": 429
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "public-access",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        }
      },
      "admin-counters-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/admin/centers/{**catch-all}"
        }
      },
      "servicecenter-route": {
        "ClusterId": "servicecenter-cluster",
        "Match": {
          "Path": "/api/service-centers/{**catch-all}"
        }
      },
      "appointment-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/appointment/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        }
      },
      "api-reports-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "token-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/token/{**catch-all}"
        }
      },
      "counters-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/counters/{**catch-all}"
        }
      },
      "queue-hub-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-micro-identity.internal.salmonisland-da9fa0a9.eastasia.azurecontainerapps.io/"
          }
        }
      },
      "servicecenter-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-micro-servicecentre.internal.salmonisland-da9fa0a9.eastasia.azurecontainerapps.io/"
          }
        }
      },
      "queue-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://qlanka-micro-queue.internal.salmonisland-da9fa0a9.eastasia.azurecontainerapps.io/"
          }
        }
      }
    }
  }
}